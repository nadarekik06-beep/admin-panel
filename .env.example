# Copy to .env.local (dev) or set on the server before `npm run build`.
# NEXT_PUBLIC_* values are baked into the bundle at build time: rebuild after changing them.

# Laravel API base URL, WITH the trailing /api. Production: https://api.choosetounsi.tn/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Realtime notifications (Pusher). Not used at launch: leave empty, the panel falls back to polling.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
